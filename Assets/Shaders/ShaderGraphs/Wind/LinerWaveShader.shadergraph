{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4a21fab440b84e74b35a779d62fb15ac",
    "m_Title": "Why Subtract y from W(first Subtraction)?",
    "m_Content": "Y = Yorig - W\r\nSince W represents the displacement in the Y-axis due to wave movement, subtracting it from y adjusts the height of the surface accordingly.\r\nThis ensures that both X and Z waves properly contribute to the displacement, rather than just overriding the previous Y value.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -408.0,
        "y": -342.66668701171877,
        "width": 331.33331298828127,
        "height": 206.00001525878907
    },
    "m_Group": {
        "m_Id": ""
    }
}

